name: YOUNGEST'S BUSINESS V64 - OPERATOR LOGOS

on:
  push:
    branches:
      - main
    paths:
      - 'YOUNGEST-BUSINESS-V64-OPERATOR-LOGOS-SOURCE.zip'
      - '.github/workflows/yb-v64-operator-logos.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: yb-v64-operator-logos
  cancel-in-progress: false

jobs:
  build-android:
    name: Validate and build V64 Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout V64
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4

      - name: Install Android SDK
        run: sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extract and validate V64
        shell: bash
        run: |
          set -euo pipefail
          ZIP="$GITHUB_WORKSPACE/YOUNGEST-BUSINESS-V64-OPERATOR-LOGOS-SOURCE.zip"
          test -s "$ZIP"
          unzip -t "$ZIP"

          DEST="$RUNNER_TEMP/yb-v64"
          mkdir -p "$DEST"
          unzip -q "$ZIP" -d "$DEST"

          for FILE in \
            app/build.gradle \
            app/src/main/AndroidManifest.xml \
            app/src/main/java/com/aistudio/youngestbiz/mbkz/MainActivity.java \
            web-admin/index.html \
            web-admin/app.js \
            web-admin/styles.css \
            firebase.json \
            .firebaserc; do
            test -s "$DEST/$FILE" || {
              echo "::error::Missing $FILE"
              exit 1
            }
          done

          grep -Eq 'versionCode[[:space:]]+64([[:space:]]|$)' "$DEST/app/build.gradle"
          node --check "$DEST/web-admin/app.js"

          for OP in mpesa airtel orange afrimoney; do
            test -s "$DEST/web-admin/assets/operators/$OP.svg"
            test -s "$DEST/app/src/main/res/drawable-nodpi/operator_$OP.png"
          done

          echo "V64_ROOT=$DEST" >> "$GITHUB_ENV"

      - name: Verify Firebase configuration
        run: |
          set -euo pipefail
          V64_ROOT="$V64_ROOT" node <<'NODE'
          const fs = require('fs');
          const path = require('path');
          const root = process.env.V64_ROOT;
          const cfg = JSON.parse(fs.readFileSync(path.join(root, 'firebase.json')));
          const rc = JSON.parse(fs.readFileSync(path.join(root, '.firebaserc')));
          if (rc.projects?.default !== 'youngestsbusiness') throw new Error('Wrong Firebase project');
          if (cfg.hosting?.public !== 'web-admin') throw new Error('Wrong Hosting directory');
          NODE

      - name: Build V64 debug APK
        run: |
          set -euo pipefail
          gradle --no-daemon -p "$V64_ROOT" clean :app:assembleDebug
          APK="$V64_ROOT/app/build/outputs/apk/debug/app-debug.apk"
          test -s "$APK"
          mkdir -p v64-output
          cp "$APK" v64-output/YOUNGEST-BUSINESS-V64-DEBUG.apk
          sha256sum v64-output/YOUNGEST-BUSINESS-V64-DEBUG.apk > v64-output/SHA256SUMS.txt

      - name: Upload V64 APK
        uses: actions/upload-artifact@v4
        with:
          name: YOUNGEST-BUSINESS-V64-DEBUG-APK
          path: v64-output/*
          if-no-files-found: error
          retention-days: 30

  deploy-hosting:
    name: Deploy V64 Web Admin - Hosting ONLY
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout V64
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Extract and validate V64 Web Admin
        run: |
          set -euo pipefail
          ZIP="$GITHUB_WORKSPACE/YOUNGEST-BUSINESS-V64-OPERATOR-LOGOS-SOURCE.zip"
          test -s "$ZIP"
          DEST="$RUNNER_TEMP/yb-v64-hosting"
          mkdir -p "$DEST"
          unzip -q "$ZIP" -d "$DEST"

          test -s "$DEST/web-admin/index.html"
          test -s "$DEST/web-admin/app.js"
          test -s "$DEST/web-admin/styles.css"
          node --check "$DEST/web-admin/app.js"

          echo "V64_ROOT=$DEST" >> "$GITHUB_ENV"

      - name: Authenticate Firebase
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_JSON }}

      - name: Install Firebase CLI
        run: npm install --global firebase-tools

      - name: Deploy Firebase Hosting ONLY
        working-directory: ${{ runner.temp }}/yb-v64-hosting
        run: |
          set -euo pipefail
          firebase deploy \
            --only hosting \
            --project youngestsbusiness \
            --non-interactive

      - name: Deployment summary
        run: |
          {
            echo "## YOUNGEST'S BUSINESS V64"
            echo "- Android debug APK build"
            echo "- Firebase Hosting only"
            echo "- Cloud Functions NOT deployed"
            echo "- Firestore rules NOT modified"
            echo "- Billing activation NOT requested"
            echo "- Old V57/V58/V59/V60/V63 workflows NOT called"
          } >> "$GITHUB_STEP_SUMMARY"
